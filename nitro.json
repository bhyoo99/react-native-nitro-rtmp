{
  "cxxNamespace": [
    "nitrortmp"
  ],
  "ios": {
    "iosModuleName": "NitroRtmp"
  },
  "android": {
    "androidNamespace": [
      "nitrortmp"
    ],
    "androidCxxLibName": "nitrortmp"
  },
  "autolinking": {
    "RtmpPublisher": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRtmpPublisher"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRtmpPublisher"
      }
    },
    "Mixer": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMixer"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridMixer"
      }
    },
    "MicrophoneSource": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMicrophoneSource"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridMicrophoneSource"
      }
    },
    "ImageLayer": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridImageLayer"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridImageLayer"
      }
    },
    "CameraLayer": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridCameraLayer"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridCameraLayer"
      }
    },
    "RtmpPreviewView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRtmpPreviewView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRtmpPreviewView"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
