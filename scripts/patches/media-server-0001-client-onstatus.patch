+static int rtmp_client_onstatus(void* param, const char* level, const char* code, const char* description)
+{
+	struct rtmp_client_t* ctx;
+	ctx = (struct rtmp_client_t*)param;
+	return ctx->handler.onstatus ? ctx->handler.onstatus(ctx->param, level, code, description) : 0;
+}
